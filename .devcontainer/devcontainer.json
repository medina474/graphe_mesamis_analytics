{
    "name": "Mes Amis - Svelte Dashboard",
    "image": "node:26",
    "forwardPorts": [5173],
    "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],
    "customizations": {
        "vscode": {
            "extensions": [
                "svelte.svelte-vscode",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode"
            ]
        }
    },

    "postCreateCommand": "npm install",

    "remoteUser": "node"
}
